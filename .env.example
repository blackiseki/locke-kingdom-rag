# 复制成 .env 再填值：  cp .env.example .env
# .env 已被 .gitignore 覆盖，不会进版本库。
# 这里的值会覆盖 application.yml 里的默认值（yml 里写的是 ${VAR:默认}）。
#
# 格式就是 KEY=VALUE，不要加引号，不要写 export。

# ---- 必填：对话模型密钥 ----
# https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=

# ---- 可选：通义千问（用于失败降级，不配也能只跑 DeepSeek）----
#DASHSCOPE_API_KEY=

# ---- 可选：想改哪个就把前面的 # 去掉 ----
# 对话模型，只能是 deepseek-flash 或 deepseek-v4-pro
#DEEPSEEK_MODEL=deepseek-flash
# 默认 Provider 与降级顺序（逗号分隔）
#LLM_PROVIDER=deepseek
#LLM_FALLBACK=tongyi

# 数据库（用 docker compose 起的库用默认值即可，不用动）
#DB_URL=jdbc:postgresql://localhost:5432/locke
#DB_USER=postgres
#DB_PASSWORD=postgres

# 语料根目录：指向你导出的游戏数据包的 public/data
# 例：D:/data/rocom/public/data 或 /data/locke（容器内）
#LOCKE_DATA_ROOT=./data

# 向量模型：换模型必须同时改 EMBEDDING_DIMENSIONS，
# 以及 V1__init_schema.sql 里的 vector(N)
#OLLAMA_BASE_URL=http://localhost:11434
#EMBEDDING_MODEL=bge-m3
#EMBEDDING_DIMENSIONS=1024

# 入库范围：true 只入 613 只已实装精灵
#INGEST_IMPLEMENTED_ONLY=true
#MAX_MOVES_PER_DOC=25
#INCLUDE_LEGACY_MOVES=true
